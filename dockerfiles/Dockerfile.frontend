FROM node:18-alpine AS deps

WORKDIR /app

# Copy dependency files
COPY apps/frontend/package.json ./
COPY apps/frontend/package-lock.jso[n] ./
COPY apps/frontend/yarn.loc[k] ./
COPY apps/frontend/pnpm-lock.yam[l] ./

# Install dependencies based on available lockfile
RUN if [ -f package-lock.json ]; then npm install --legacy-peer-deps; \
    elif [ -f yarn.lock ]; then yarn --frozen-lockfile; \
    elif [ -f pnpm-lock.yaml ]; then npm install -g pnpm && pnpm i --frozen-lockfile; \
    else npm install; \
    fi

FROM node:18-alpine AS builder

WORKDIR /app
COPY apps/frontend/ .
COPY --from=deps /app/node_modules ./node_modules

# Build the frontend application
RUN npm run build

# Final stage using nginx to serve static files
FROM nginx:alpine

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
